# Copy this file to .env and replace every placeholder before starting the stack.
MYSQL_DATABASE=client_data
MYSQL_USER=n8n_api
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Use a stable random value. Keep it unchanged after the first launch.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
TZ=UTC